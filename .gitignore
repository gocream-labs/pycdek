*.log
*.mo
*.py[cod]
*.sublime-project
*.sublime-workspace
*~
.*

# Исключения из `.*` - конфиги, которые должны быть в репозитории.
# Слэш в конце обязателен: без него git не заходит внутрь исключённой
# директории, и правила для вложенных файлов не сработают.
!.gitignore
!.editorconfig
!.gitattributes
!.gitlint
!.github/
!.pre-commit-config.yaml
!.git-blame-ignore-revs
!.linkcheckerrc
!.mailmap
!templates/.components/
!templates/.release_notes.md.j2

__pycache__
coverage.xml
htmlcov
dist
/venv
/env
/build
/site
/share
/stuff
